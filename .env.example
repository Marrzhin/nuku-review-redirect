# =====================================================================
# Salin file ini jadi .env, lalu sesuaikan.
# Nilai default di bawah sudah siap untuk DEV LOKAL (tanpa perlu MariaDB).
# Baris bertanda [VPS] adalah yang perlu diganti saat deploy ke server.
# =====================================================================

# --- Dev lokal: SQLite, tidak butuh MariaDB jalan --------------------
DATABASE_URL=sqlite+aiosqlite:///./dev.db

# --- [VPS] Produksi: aktifkan baris ini, komentari yang di atas ------
# Password MariaDB mengandung "@" -> WAJIB ditulis %40 di URL koneksi,
# kalau tidak, parser salah membaca batas password dan hostname.
# DATABASE_URL=mysql+aiomysql://nuku_admin:PASSWORD_DI_ENCODE@localhost/nuku_redirect

# Kunci admin. WAJIB diganti sebelum dipakai:
#   openssl rand -hex 32
ADMIN_API_KEY=ganti-dengan-key-acak-yang-panjang

# Domain publik, dipakai untuk isi QR code -> {BASE_URL}/r/{slug}
# Ini tercetak permanen di akrilik klien — jangan diubah setelah produksi jalan.
BASE_URL=https://go.nukustudio.id

# Port lokal yang didengar run.py. Nginx mem-proxy ke sini.
PORT=8000
DEBUG=false

# Places API (New) untuk /admin/lookup-place.
# Restrict key ini ke Places API saja, idealnya per-IP VPS.
# Boleh dikosongkan: endpoint lookup akan balas 503 dengan pesan jelas,
# endpoint lain tetap jalan normal.
GOOGLE_PLACES_API_KEY=

# Nomor WhatsApp di halaman "kartu belum aktif".
# Format internasional tanpa + dan tanpa 0 di depan. Kosongkan untuk
# menyembunyikan tombolnya.
WHATSAPP_NUMBER=6282394707711
